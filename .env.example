# Copy this file to .env and fill in real values.
# Never commit the actual .env file — it's already in .gitignore.

POSTGRES_DB=attendance
POSTGRES_USER=attendance_app
POSTGRES_PASSWORD=change_me_to_a_strong_password

# ASP.NET Core JWT signing. appsettings.Development.json (where these live
# for local dev) is never loaded when ASPNETCORE_ENVIRONMENT=Production, so
# both are required here or the API throws on the first request.
#   Generate JWT_KEY with: openssl rand -base64 48
JWT_KEY=change_me_to_a_long_random_string
JWT_ISSUER=attendance-api

# AES-256 key (base64) used to encrypt fingerprint templates at rest.
#   Generate with: openssl rand -base64 32
TEMPLATE_ENCRYPTION_KEY=change_me_to_a_base64_32_byte_key

# Bootstraps the one "Operator" account on first startup (skipped if a user
# with this email already exists). Operator is the only role that can create
# a Tenant — you need this at least once to get your first client set up via
# POST /api/tenants, after which you can blank these back out in .env.
OPERATOR_EMAIL=
OPERATOR_PASSWORD=
